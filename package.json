{
  "name": "metrofix-root",
  "private": true,
  "engines": {
    "node": ">=22.22.1",
    "npm": ">=9.2.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=9.2.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "api:dev": "npm run dev --workspace apps/api",
    "web:dev": "npm run dev --workspace apps/web",
    "dev:all": "npx --yes concurrently@9.1.2 -k -n api,web,mobile -c blue,green,magenta \"npm:api:dev\" \"npm:web:dev\" \"npm:mobile:web\"",
    "mobile:web": "npm run web --workspace apps/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "expo": "~56.0.0",
    "jest": "^29.7.0",
    "turbo": "^2.10.5"
  }
}
