# Used by release builds (NODE_ENV=production: the Android release APK, the iOS Release / archive build).
# Debug builds started with Metro keep using .env (a local API). The address is public, so this file is
# committed. It is read when the JavaScript is bundled, so rebuild the app after changing it.
#
# The API on its own domain (a CNAME to the Render service; see HOSTING.md). The Render address
# https://metrofix-api.onrender.com also works if the domain is ever unavailable.
EXPO_PUBLIC_API_URL=https://api-metrofix.vanguardprotection.lk
