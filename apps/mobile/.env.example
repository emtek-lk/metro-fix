# ====================================
# METRO-FIX Mobile — Environment Variables
# ====================================
# Expo exposes variables prefixed with EXPO_PUBLIC_ to client code.

# Android Emulator: http://10.0.2.2:3000
# iOS Simulator:    http://localhost:3000
# Physical Device:  http://<your-local-ip>:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Release builds (the Android release APK, the iOS Release / Archive build) read .env.production instead,
# which is committed and points at the hosted API. To try the hosted API from a debug build, start Metro with
#   EXPO_PUBLIC_API_URL=https://api-metrofix.vanguardprotection.lk npx react-native start --reset-cache
# The address is fixed when the JavaScript is bundled: rebuild (or reload Metro with --reset-cache) after changing it.
