# ====================================
# METRO-FIX API — Environment Variables
# ====================================
# Copy this file to .env and fill in your values.

# --- Database (MSSQL) ---
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=YourPassword123!
DB_NAME=metrofix_db
DB_SYNCHRONIZE=true
TRUST_SERVER_CERTIFICATE=true

# --- Authentication ---
JWT_SECRET=your-jwt-secret-key-here

# --- Server ---
PORT=3000
CORS_ORIGIN=*

# --- Worker Provisioning ---
WORKER_DEFAULT_PASSWORD=ChangeMe123!
