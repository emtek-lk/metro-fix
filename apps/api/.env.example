# ====================================
# METRO-FIX API — Environment Variables
# ====================================
# Copy this file to .env and fill in your values.

# --- Database (MSSQL) ---
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=YourPassword123!
DB_NAME=metrofix_db
DB_SYNCHRONIZE=true
# Local docker SQL Server: encryption off, self-signed certificate trusted.
# Hosted database (Azure SQL): DB_ENCRYPT=true and TRUST_SERVER_CERTIFICATE=false.
DB_ENCRYPT=false
TRUST_SERVER_CERTIFICATE=true
# A paused serverless database (Azure SQL free tier) can take a minute or more to wake. Hosted: 90000 / 30 / 5000.
DB_CONNECT_TIMEOUT_MS=15000
DB_RETRY_ATTEMPTS=9
DB_RETRY_DELAY_MS=3000
# How often unanswered job offers are checked (seconds). Every check is a database query: hosted free tier uses 60.
OFFER_SWEEP_INTERVAL_SECONDS=5

# --- Authentication ---
JWT_SECRET=your-jwt-secret-key-here
# Hosted systems: the password the seeded admin@demo.local and dispatch@demo.local accounts are created
# with (12+ characters, letters and numbers), instead of the public demo password. Leave unset locally.
STAFF_INITIAL_PASSWORD=

# --- Server ---
PORT=3000
# Browser origins allowed to call the API in production (comma separated; * stands for one hostname label).
# Development also allows localhost and *.localhost automatically.
CORS_ORIGINS=https://metrofix.example.lk,https://admin.metrofix.example.lk
