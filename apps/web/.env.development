# Local development. Nothing is needed here: the website works out its own API address from the page
# it is opened on (localhost, metrofix.localhost, admin.metrofix.localhost all use http://localhost:3000).
# Local names follow the same flat style as production: metrofix.localhost is the customer site and
# admin-metrofix.localhost is the staff site (admin.metrofix.localhost works too).
VITE_HOST_STYLE=dash
# Uncomment to point at a different API.
# VITE_API_URL=http://localhost:3000
