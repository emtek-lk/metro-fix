# ====================================
# METRO-FIX Web — Environment Variables
# ====================================
# Vite exposes variables prefixed with VITE_ to client code. All are optional: with none set the website
# works out which site it is (staff or customer) and where its API is from the address in the browser.

# Full API address. Overrides the automatic one (localhost -> :3000, otherwise api.<site>).
# VITE_API_URL=http://localhost:3000

# The first hostname label that marks the staff site (default "admin": admin.metrofix.example.lk).
# VITE_ADMIN_SUBDOMAIN=admin

# Force one audience whatever the address: admin | customer | any.
# VITE_SURFACE=any
