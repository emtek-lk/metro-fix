# ==========================================
# METRO-FIX Monorepo — Global .gitignore
# ==========================================

# --- Dependencies ---
node_modules/

# --- Build Outputs (all packages & apps) ---
dist/
build/
.turbo/
*.tsbuildinfo

# --- Environment Secrets ---
.env
.env.local
.env.*.local

# --- OS & Editor ---
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Expo / React Native ---
.expo/
.expo-shared/
apps/mobile/android/.gradle/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/local.properties
apps/mobile/android/*.skp
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/ios/DerivedData/
apps/mobile/ios/.xcode.env.local

# --- Web ---
apps/web/.eslintcache

# --- Testing ---
coverage/
