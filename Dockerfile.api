# syntax=docker/dockerfile:1
#
# Production image for the METRO-FIX API (used by Render; see render.yaml and HOSTING.md).
# Local development keeps using the plain `Dockerfile` + compose.yml: this file is not referenced
# by them. Build it from the repository root:
#   docker build -f Dockerfile.api -t metrofix-api .
#
# Why the `node -e` step below: the repo pins npm 9 for development (devEngines), but npm 9 crashes
# on `npm ci --workspace`, which is what lets this image install only the API and core-types
# (about 170 packages instead of the whole monorepo). Node 22's npm 10 does that correctly but
# refuses the pin, so the pin is stripped from the copies of package.json / package-lock.json
# inside the image. The repository files themselves are not touched.

# ---- build: install what the API needs, compile core-types and the API ----
FROM node:22.22.1-alpine AS build
WORKDIR /workspace

# Every workspace's manifest must be present so the lockfile stays consistent, but only the API and
# core-types (plus the shared tsconfig) are installed (the web and mobile dependencies are not needed here).
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/mobile/package.json apps/mobile/
COPY packages/core-types/package.json packages/core-types/
COPY packages/ui/package.json packages/ui/
COPY packages/ts-config/package.json packages/ts-config/
RUN node -e "const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json'));delete p.devEngines;fs.writeFileSync('package.json',JSON.stringify(p,null,2));const l=JSON.parse(fs.readFileSync('package-lock.json'));if(l.packages&&l.packages['']){delete l.packages[''].devEngines;}fs.writeFileSync('package-lock.json',JSON.stringify(l,null,2));" \
 && npm ci --workspace apps/api --workspace packages/core-types --workspace packages/ts-config

COPY packages/ts-config packages/ts-config
COPY packages/core-types packages/core-types
COPY apps/api apps/api
RUN npm run build --workspace packages/core-types \
 && npm run build --workspace apps/api

# ---- runtime: production dependencies and compiled output only ----
FROM node:22.22.1-alpine AS runtime
WORKDIR /workspace
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/mobile/package.json apps/mobile/
COPY packages/core-types/package.json packages/core-types/
COPY packages/ui/package.json packages/ui/
COPY packages/ts-config/package.json packages/ts-config/
RUN node -e "const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json'));delete p.devEngines;fs.writeFileSync('package.json',JSON.stringify(p,null,2));const l=JSON.parse(fs.readFileSync('package-lock.json'));if(l.packages&&l.packages['']){delete l.packages[''].devEngines;}fs.writeFileSync('package-lock.json',JSON.stringify(l,null,2));" \
 && npm ci --omit=dev --workspace apps/api --workspace packages/core-types \
 && npm cache clean --force

COPY --from=build /workspace/packages/core-types/dist packages/core-types/dist

# Run from apps/api, as in development: the database driver is installed under apps/api/node_modules
# and TypeORM looks for it relative to the working directory.
WORKDIR /workspace/apps/api
COPY --from=build /workspace/apps/api/dist dist

# Uploaded job photos are written to ./uploads. On a host with no persistent disk (Render free) they
# do not survive a restart; see HOSTING.md.
RUN mkdir -p uploads && chown -R node:node uploads
USER node

# Render sets PORT (10000 by default); the API reads it.
EXPOSE 10000
CMD ["node", "dist/main.js"]
